# GoldAITrader Environment Configuration
DATA_MODE=MOCK
OPERATING_MODE=MONITORING
ALLOW_DEMO_TRADING=false

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///../database/goldaitrader.db

# Broker & Symbol (Exness Standard Cent)
BROKER_NAME=Exness
ACCOUNT_TYPE=CENT
ACCOUNT_CURRENCY=USC
INITIAL_CAPITAL=10000.0
DEFAULT_SYMBOL=XAUUSDc
MT5_TERMINAL_PATH=

# Risk Management Defaults
RISK_PERCENT_PER_TRADE=0.5
MAX_DAILY_LOSS_PERCENT=2.0
MAX_DRAWDOWN_PERCENT=10.0
MAX_DAILY_TRADES=3
MAX_SIMULTANEOUS_POSITIONS=1
RISK_REWARD_RATIO=2.0
MAX_CONSECUTIVE_LOSSES=3

# AI Service
AI_MODEL_DIR=models
AI_MIN_CONFIDENCE=0.55
AI_PREDICTION_TTL_SECONDS=900
